# Otty theme — Rosé Pine
# The shipped Otty 1.5.4 theme text, comments and all. Sole deliberate deviation:
# [token].font-ui = ["Styrene B", "Styrene A"] (appended here); the shipped build named the
# platform UI stack there (Segoe UI / SF Pro / -apple-system / Inter).
# Shipped palette repeats, do not "fix": 1:9, 2:10, 3:11, 4:12, 5:13, 6:14, 7:15.
[meta]
name = "Rosé Pine"
mode = "dark"

[terminal]
foreground = "#E0DEF4"
background = "#191724"
palette = [
    "#26233A", "#EB6F92", "#31748F", "#F6C177",
    "#9CCFD8", "#C4A7E7", "#EBBCBA", "#E0DEF4",
    "#6E6A86", "#EB6F92", "#31748F", "#F6C177",
    "#9CCFD8", "#C4A7E7", "#EBBCBA", "#E0DEF4",
]

[token]
font-ui = ["Styrene B", "Styrene A"]
