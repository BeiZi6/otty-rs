# Otty theme — Owl
# The shipped Otty 1.5.4 theme text, comments and all. Sole deliberate deviation:
# [token].font-ui = ["Styrene B", "Styrene A"] (appended here); the shipped build named the
# platform UI stack there (Segoe UI / SF Pro / -apple-system / Inter).
# Shipped palette repeats, do not "fix": 2:10, 3:11, 4:12, 5:13, 6:14.
[meta]
name = "Owl"
mode = "dark"

[terminal]
foreground           = "#DEDEDE"
background           = "#2F2B2C"
cursor               = "#DEDEDE"
cursor-text          = "#2F2B2C"
selection-foreground = "#2F2B2C"
selection-background = "#DEDEDE"
palette = [
    "#302C2C", "#5A5A5A", "#989898", "#CACACA",
    "#656565", "#B1B1B1", "#7F7F7F", "#DEDEDE",
    "#5D595B", "#DA5B2C", "#989898", "#CACACA",
    "#656565", "#B1B1B1", "#7F7F7F", "#FFFFFF",
]

[token]
font-ui = ["Styrene B", "Styrene A"]
