// Otty's window, in Slint.
//
// Every colour, radius and measurement here is an **input** — the Rust side sets
// them from `otty_render::theme::Chrome`, which derives them from a `.ottytheme`.
// Nothing in this file hard-codes an appearance value, because a theme the user
// imports has to change the window and not just the text.
//
// The structure follows the recovered theme sections one for one, so a key in a
// theme file has exactly one place to land:
//
//   [titlebar]        → titlebar
//   [tab-bar] / [tab] → tab-strip / tab
//   [sidebar]         → sidebar
//   [panel]           → details-panel
//   [container]       → inset / radius on the pane holder
//   [divider]         → divider
//
// The grid is an `Image` because the pixels are composited in Rust
// (`otty_render::raster`), which keeps the glyph atlas and the row-dirty logic in
// one place instead of splitting them between Rust and the UI toolkit.

import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct MenuRow {
    title: string,
    action: string,
}

export struct PaletteRow {
    title: string,
    action: string,
    scope: string,
}

// What Otty 1.5.4 opens on, from the shipped themes, so the window is usable for
// the first frame before the Rust side has loaded anything.
export global Theme {
    in property <color> window-background: #101014;
    in property <color> titlebar-background: #101014;
    in property <color> titlebar-foreground: #d0d0d0;
    in property <length> titlebar-height: 38px;

    in property <color> tabbar-background: #101014;
    in property <color> tab-background: #181820;
    in property <color> tab-foreground: #a0a0a8;
    in property <color> tab-active-background: #202028;
    in property <color> tab-active-foreground: #ffffff;
    in property <color> tab-hover-background: #1c1c24;
    in property <color> tab-indicator: #7aa2f7;
    in property <length> tab-radius: 6px;
    in property <length> tab-height: 30px;

    in property <color> sidebar-background: #0c0c10;
    in property <color> sidebar-foreground: #c0c0c8;
    in property <color> sidebar-border: #ffffff10;
    in property <length> sidebar-width: 220px;

    in property <color> panel-background: #0c0c10;
    in property <color> panel-foreground: #c0c0c8;
    in property <color> panel-border: #ffffff10;
    in property <length> panel-radius: 8px;

    in property <color> divider: #ffffff14;
    in property <length> divider-width: 6px;

    // The radius the whole window is drawn with. A square window is the default;
    // the `floating-card` theme rounds it.
    in property <length> window-radius: 0px;
}

// One tab in the strip.
component Tab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> hovered;
    in property <color> indicator: transparent;

    height: Theme.tab-height;
    // Width follows the title, clamped, so a long title cannot push the strip
    // off the window and a one-letter title does not look like a button.
    width: min(max(title-text.preferred-width + 28px, 90px), 240px);

    background: active
        ? Theme.tab-active-background
        : (hovered ? Theme.tab-hover-background : Theme.tab-background);
    border-radius: Theme.tab-radius;

    title-text := Text {
        text: root.title;
        color: root.active ? Theme.tab-active-foreground : Theme.tab-foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
        font-size: 12px;
    }

    // The active tab's underline. It is drawn even when the two tab colours are
    // close together, which is what makes the selection readable in the light
    // themes.
    Rectangle {
        visible: root.active;
        y: root.height - 2px;
        height: 2px;
        width: root.width - 16px;
        x: 8px;
        background: root.indicator;
        border-radius: 1px;
    }
}

// A split divider. The drag handling lives in Rust, because the ratio belongs to
// the model and the model has the tests. Not `export`ed: an exported component
// that is not a `Window` generates no Rust code, so the export would only be a
// claim that something on the other side can build one.
component Divider inherits Rectangle {
    in property <bool> vertical;
    background: Theme.divider;
    width: vertical ? Theme.divider-width : 0px;
    height: vertical ? 0px : Theme.divider-width;
}

// The sidebar: recent folders and agent sessions.
component Sidebar inherits Rectangle {
    in property <[string]> folders;

    width: Theme.sidebar-width;
    background: Theme.sidebar-background;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.sidebar-border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        Text {
            text: "Folders";
            color: Theme.sidebar-foreground.with-alpha(0.6);
            font-size: 11px;
            height: 22px;
            vertical-alignment: center;
        }

        for name in root.folders : Text {
            text: name;
            color: Theme.sidebar-foreground;
            font-size: 12px;
            height: 24px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component OttyWindow inherits Window {
    // Set from Rust.
    in property <image> grid;
    in property <string> title-text: "Otty";
    in property <[string]> tabs;
    in-out property <int> active-tab: 0;
    in property <[string]> folders;
    in property <bool> sidebar-visible: true;
    in property <[MenuRow]> menu-file;
    in property <[MenuRow]> menu-edit;
    in property <[MenuRow]> menu-view;
    in property <[MenuRow]> menu-shell;
    in property <[MenuRow]> menu-window;
    in property <[MenuRow]> menu-commands;
    in property <[MenuRow]> ctx-pane;
    callback menu-activated(string);
    callback context-prepare(length, length);
    callback close-tab-at(int);
    callback select-tab-at(int);
    in-out property <bool> details-open: false;
    in-out property <string> details-tab: "info";
    in property <string> details-cwd: "";
    callback details-select-tab(string);
    in-out property <bool> settings-open: false;
    in-out property <int> settings-font-size: 13;
    callback settings-apply-font(int);
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in property <[PaletteRow]> palette-rows;
    callback palette-query-changed(string);
    callback palette-run(string, bool);
    in-out property <bool> quickly-open: false;
    in-out property <string> quickly-query: "";
    in-out property <string> quickly-filter: "all";
    in property <[PaletteRow]> quickly-rows;
    callback quickly-query-changed(string);
    callback quickly-run(string);
    callback quickly-set-filter(string);

    // The pointer's position over the grid, in the grid image's coordinates, so
    // Rust can turn it into a cell without knowing about Slint.
    // `in-out`, not `in`: the `TouchArea` writes these and Rust reads them, so
    // Slint rejects an assignment to a pure input.
    in-out property <length> pointer-x: 0px;
    in-out property <length> pointer-y: 0px;
    callback pointer-moved(length, length);
    // Named apart from Window's own `key-pressed(KeyEvent)`, which we forward
    // into this from the FocusScope below.
    callback input-key(string);
    // The *pane*'s size, not the window's: the titlebar and sidebar are already
    // subtracted, so Rust can size the grid to the pixels that will show it.
    callback resized(length, length);

    background: Theme.window-background;
    title: root.title-text;
    preferred-width: 1000px;
    preferred-height: 640px;
    default-font-size: 12px;
    forward-focus: key-catcher;

    MenuBar {
        Menu {
            title: "File";
            for row in root.menu-file: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
        Menu {
            title: "Edit";
            for row in root.menu-edit: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
        Menu {
            title: "View";
            for row in root.menu-view: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
        Menu {
            title: "Shell";
            for row in root.menu-shell: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
        Menu {
            title: "Window";
            for row in root.menu-window: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
        Menu {
            title: "Commands";
            for row in root.menu-commands: MenuItem {
                title: row.title;
                activated => { root.menu-activated(row.action); }
            }
        }
    }

    // The rounded corner, when the theme asks for one. A `Rectangle` rather than
    // a window-level property, because Slint has no cross-platform window radius.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.window-radius;
        clip: true;
        background: Theme.window-background;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            // ------------------------------------------------------ titlebar
            Rectangle {
                height: Theme.titlebar-height;
                background: Theme.titlebar-background;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: start;

                    // Slint's index binding is `for item[index] in model`; the
                    // `, index in` form is not a syntax it has.
                    for title[index] in root.tabs : ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Close Tab";
                                activated => {
                                    root.close-tab-at(index);
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-tab = index;
                                root.select-tab-at(index);
                            }
                            Tab {
                                title: title;
                                active: index == root.active-tab;
                                indicator: Theme.tab-indicator;
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------------ body
            HorizontalLayout {
                height: 0px;
                vertical-stretch: 1;
                spacing: 0px;

                if root.sidebar-visible : Sidebar {
                    folders: root.folders;
                    height: 100%;
                }

                // The terminal. A `TouchArea` covers it so pointer motion and
                // clicks reach Rust; the image itself is not interactive.
                pane := ContextMenuArea {
                    height: 100%;
                    Menu {
                        for row in root.ctx-pane: MenuItem {
                            title: row.title;
                            activated => { root.menu-activated(row.action); }
                        }
                    }
                    Rectangle {
                        background: Theme.window-background;
                        height: 100%;
                        // Report this rectangle, not the window: the grid is laid
                        // out in the leftover space after the titlebar and sidebar.
                        changed width => { root.resized(self.width, self.height); }
                        changed height => { root.resized(self.width, self.height); }

                        // `grid` is the whole composited screen for now: one pane per
                        // window. Splitting arrives with the multi-pane view, and the
                        // divider component above is already here for it.
                        Image {
                            source: root.grid;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }

                        pointer := TouchArea {
                            mouse-cursor: text;
                            moved => {
                                root.pointer-x = self.mouse-x;
                                root.pointer-y = self.mouse-y;
                                root.pointer-moved(self.mouse-x, self.mouse-y);
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.pointer-moved(self.mouse-x, self.mouse-y);
                                    if (event.button == PointerEventButton.right) {
                                        root.context-prepare(self.mouse-x, self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.details-open : Rectangle {
                    width: 260px;
                    height: 100%;
                    background: Theme.panel-background;

                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.panel-border;
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: "Details";
                            color: Theme.panel-foreground;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            TouchArea {
                                clicked => { root.details-select-tab("info"); }
                                Text {
                                    text: "Info";
                                    color: Theme.panel-foreground;
                                    font-size: 12px;
                                    opacity: root.details-tab == "info" ? 1.0 : 0.6;
                                }
                            }
                            TouchArea {
                                clicked => { root.details-select-tab("outline"); }
                                Text {
                                    text: "Outline";
                                    color: Theme.panel-foreground;
                                    font-size: 12px;
                                    opacity: root.details-tab == "outline" ? 1.0 : 0.6;
                                }
                            }
                            TouchArea {
                                clicked => { root.details-select-tab("git"); }
                                Text {
                                    text: "Git";
                                    color: Theme.panel-foreground;
                                    font-size: 12px;
                                    opacity: root.details-tab == "git" ? 1.0 : 0.6;
                                }
                            }
                            TouchArea {
                                clicked => { root.details-select-tab("files"); }
                                Text {
                                    text: "Files";
                                    color: Theme.panel-foreground;
                                    font-size: 12px;
                                    opacity: root.details-tab == "files" ? 1.0 : 0.6;
                                }
                            }
                        }

                        Text {
                            text: "cwd: " + root.details-cwd;
                            color: Theme.panel-foreground;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    if root.settings-open : Rectangle {
        x: parent.width - 340px;
        y: Theme.titlebar-height + 8px;
        width: 320px;
        height: 140px;
        background: Theme.panel-background;
        border-width: 1px;
        border-color: Theme.panel-border;
        border-radius: Theme.panel-radius;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                Text {
                    text: "Settings";
                    color: Theme.panel-foreground;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.settings-open = false; }
                    Text {
                        text: "×";
                        color: Theme.panel-foreground;
                        horizontal-alignment: center;
                    }
                }
            }

            Text {
                text: "Font size: " + root.settings-font-size;
                color: Theme.panel-foreground;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 8px;
                TouchArea {
                    width: 32px;
                    height: 28px;
                    clicked => {
                        if (root.settings-font-size > 8) {
                            root.settings-font-size -= 1;
                            root.settings-apply-font(root.settings-font-size);
                        }
                    }
                    Text { text: "−"; color: Theme.panel-foreground; horizontal-alignment: center; }
                }
                TouchArea {
                    width: 32px;
                    height: 28px;
                    clicked => {
                        if (root.settings-font-size < 72) {
                            root.settings-font-size += 1;
                            root.settings-apply-font(root.settings-font-size);
                        }
                    }
                    Text { text: "+"; color: Theme.panel-foreground; horizontal-alignment: center; }
                }
            }
        }
    }

    if root.quickly-open : Rectangle {
        x: (parent.width - 480px) / 2;
        y: Theme.titlebar-height + 24px;
        width: 480px;
        height: 320px;
        background: Theme.panel-background;
        border-width: 1px;
        border-color: Theme.panel-border;
        border-radius: Theme.panel-radius;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Text {
                text: "Open Quickly";
                color: Theme.panel-foreground;
                font-size: 13px;
            }

            quickly-box := TextInput {
                text <=> root.quickly-query;
                color: Theme.panel-foreground;
                height: 24px;
                edited => { root.quickly-query-changed(self.text); }
                accepted => {
                    if (root.quickly-rows.length > 0) {
                        root.quickly-run(root.quickly-rows[0].action);
                    }
                }
            }

            for row in root.quickly-rows : TouchArea {
                height: 22px;
                clicked => { root.quickly-run(row.action); }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: row.title;
                        color: Theme.panel-foreground;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: row.scope;
                        color: Theme.panel-foreground;
                        font-size: 11px;
                        opacity: 0.6;
                    }
                }
            }
        }
    }

    if root.palette-open : Rectangle {
        x: (parent.width - 480px) / 2;
        y: Theme.titlebar-height + 24px;
        width: 480px;
        height: 320px;
        background: Theme.panel-background;
        border-width: 1px;
        border-color: Theme.panel-border;
        border-radius: Theme.panel-radius;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Text {
                text: "Command Palette";
                color: Theme.panel-foreground;
                font-size: 13px;
            }

            palette-box := TextInput {
                text <=> root.palette-query;
                color: Theme.panel-foreground;
                height: 24px;
                edited => { root.palette-query-changed(self.text); }
                accepted => {
                    if (root.palette-rows.length > 0) {
                        root.palette-run(root.palette-rows[0].action, false);
                    }
                }
            }

            for row in root.palette-rows : TouchArea {
                height: 22px;
                clicked => { root.palette-run(row.action, false); }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: row.title;
                        color: Theme.panel-foreground;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: row.scope;
                        color: Theme.panel-foreground;
                        font-size: 11px;
                        opacity: 0.6;
                    }
                }
            }
        }
    }

    // Keys land on a FocusScope that covers the window, because the Image is
    // not a focusable item and Window's own key-pressed would collide with a
    // callback of the same name.
    key-catcher := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (root.palette-open) {
                // ⌘↩ / Ctrl+Enter: run the first row and keep the palette open.
                if (event.text == "\n" && (event.modifiers.control || event.modifiers.meta)) {
                    if (root.palette-rows.length > 0) {
                        root.palette-run(root.palette-rows[0].action, true);
                    }
                    accept
                }
                reject
            }
            if (root.quickly-open) {
                if (event.modifiers.control || event.modifiers.meta) {
                    root.quickly-set-filter(event.text);
                    accept
                }
                reject
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && (event.text == "p" || event.text == "P")) {
                root.palette-open = true;
                root.palette-query = "";
                root.palette-query-changed("");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && (event.text == "o" || event.text == "O")) {
                root.quickly-open = true;
                root.quickly-query = "";
                root.quickly-filter = "all";
                root.quickly-set-filter("all");
                root.quickly-query-changed("");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && (event.text == "r" || event.text == "R")) {
                root.details-open = !root.details-open;
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.alt
                && event.modifiers.shift && (event.text == "d" || event.text == "D")) {
                root.menu-activated("split_up");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.alt
                && (event.text == "d" || event.text == "D")) {
                root.menu-activated("split_left");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && (event.text == "d" || event.text == "D")) {
                root.menu-activated("split_down");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta)
                && (event.text == "d" || event.text == "D")) {
                root.menu-activated("split_right");
                accept
            }
            if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && event.text == "\n") {
                root.menu-activated("zoom_split");
                accept
            }
            root.input-key(event.text);
            accept
        }
    }

    init => {
        key-catcher.focus();
    }
}
