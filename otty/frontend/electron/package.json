{
  "name": "otty-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Electron frontend for Otty's Rust terminal engine",
  "main": "main.js",
  "scripts": {
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const d of ['.','renderer','renderer/features'])for(const f of fs.readdirSync(d))if(f.endsWith('.js'))cp.execFileSync(process.execPath,['--check',d+'/'+f],{stdio:'inherit'})\"",
    "test": "node --test",
    "build:engine": "cargo build -p otty-bridge",
    "dev": "npm run build:engine && electron .",
    "start": "npm run dev"
  },
  "devDependencies": {
    "electron": "^43.2.0"
  },
  "allowScripts": {
    "electron": true
  }
}
